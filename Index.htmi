<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Afan Gaming Hub</title>

<style>
body{
margin:0;
font-family:Arial,sans-serif;
background:#111;
color:white;
}
header{
background:#1f1f1f;
padding:20px;
text-align:center;
}
h1{
margin:0;
color:#00ff99;
}
.search{
text-align:center;
padding:15px;
}
input{
width:90%;
padding:12px;
border:none;
border-radius:8px;
font-size:16px;
}
.games{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
padding:15px;
}
.card{
background:#222;
padding:15px;
border-radius:12px;
text-align:center;
}
.card h3{
margin:10px 0;
}
button{
background:#00ff99;
color:black;
border:none;
padding:10px 20px;
border-radius:8px;
font-weight:bold;
}
footer{
text-align:center;
padding:20px;
background:#1f1f1f;
margin-top:20px;
}
</style>

</head>

<body>

<header>
<h1>🎮 Afan Gaming Hub</h1>
<p>Play Free Games Online</p>
</header>

<div class="search">
<input type="text" placeholder="Search Games...">
</div>

<div class="games">

<div class="card">
<h3>Car Racing</h3>
<button>Play Now</button>
</div>

<div class="card">
<h3>Snake Game</h3>
<button>Play Now</button>
</div>

<div class="card">
<h3>Puzzle Game</h3>
<button>Play Now</button>
</div>

<div class="card">
<h3>Shooting Game</h3>
<button>Play Now</button>
</div>

<div class="card">
<h3>Chess</h3>
<button>Play Now</button>
</div>

<div class="card">
<h3>Football</h3>
<button>Play Now</button>
</div>

</div>

<footer>
© 2026 Afan Gaming Hub
</footer>

</body>
</html>
